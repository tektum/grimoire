{
  "name": "grimoire",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "lint": "eslint . && node tools/ci/check-test-sleeps.mjs && node tools/ci/check-test-db-urls.mjs && node tools/ci/check-ts-projects.mjs && node tools/ci/check-operator-sites.mjs",
    "typecheck": "bun run build && node tools/ci/typecheck-tests.mjs",
    "seed": "node apps/server/dist/cli.js seed",
    "test": "vitest run --project unit --project web",
    "test:coverage": "vitest run --project unit --project web --coverage",
    "test:coverage:ci": "vitest run --project unit --project web --coverage --reporter=default --reporter=blob --outputFile.blob=vitest-blobs/unit.json",
    "test:coverage:merged": "vitest --config vitest.merged-coverage.config.js --merge-reports=vitest-blobs",
    "test:benchmark": "vitest run --project benchmark --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:integration:coverage": "vitest run --config vitest.integration-coverage.config.js --project integration --passWithNoTests",
    "test:integration:coverage:ci": "vitest run --config vitest.integration-coverage.config.js --project integration --passWithNoTests --reporter=default --reporter=blob --outputFile.blob=vitest-blobs/integration.json",
    "test:container": "vitest run --project container --passWithNoTests",
    "build": "bun run build:server && bun run openapi && tsc -b",
    "build:server": "tsc -b apps/server",
    "licence": "node tools/licence-report/run.mjs",
    "licence:check-images": "node tools/licence-report/run.mjs --check-images",
    "test:tools": "node --test tools/licence-report/test/ tools/ci/test/ tools/m3-live/test/",
    "licence:pending": "node tools/licence-report/run.mjs --allow-pending",
    "openapi": "node apps/server/dist/openapi/emit.js && openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.d.ts",
    "openapi:surface": "bun run build && node apps/server/dist/openapi/emit.js --write-surface",
    "openapi:check": "bun run build && node apps/server/dist/openapi/emit.js --check-surface",
    "test:conformance": "vitest run --project unit --project integration --passWithNoTests conformance",
    "check:tsc-time": "node tools/check-tsc-time.mjs",
    "check:infra": "sst install && tsc -p tsconfig.sst.json; rc=$?; rm -rf .sst; exit $rc"
  },
  "trustedDependencies": [],
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "sst": "4.17.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
