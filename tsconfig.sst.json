{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "sst.config.ts",
    "infra/**/*.ts",
    "infra/**/*.json",
    ".sst/platform/config.d.ts"
  ]
}
