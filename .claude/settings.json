{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(mise exec -- bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(mise exec -- bun run typecheck)",
      "Bash(bun run build)",
      "Bash(mise exec -- bun run build)",
      "Bash(bun run test)",
      "Bash(mise exec -- bun run test)",
      "Bash(bun run test:tools)",
      "Bash(mise exec -- bun run test:tools)",
      "Bash(bun run test:integration)",
      "Bash(mise exec -- bun run test:integration)",
      "Bash(bun run test:container)",
      "Bash(mise exec -- bun run test:container)",
      "Bash(bun run test:benchmark)",
      "Bash(mise exec -- bun run test:benchmark)",
      "Bash(node tools/ci/check-test-sleeps.mjs)",
      "Bash(mise exec -- node tools/ci/check-test-sleeps.mjs)",
      "Bash(gitleaks git --config .gitleaks.toml --redact .)",
      "Bash(mise exec -- gitleaks git --config .gitleaks.toml --redact .)",
      "Bash(gitleaks dir --config .gitleaks.toml --redact .)",
      "Bash(mise exec -- gitleaks dir --config .gitleaks.toml --redact .)"
    ],
    "deny": [
      "Edit(**/bun.lock)",
      "Edit(**/dist/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
