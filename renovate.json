{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "at any time"
  ],
  "prConcurrentLimit": 5,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "0.x minor bumps can be breaking; keep manual",
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Major updates stay manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "github-actions": {
    "pinDigests": true
  },
  "mise": {
    "enabled": true
  },
  "bun": {
    "enabled": true
  }
}
