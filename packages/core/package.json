{
  "name": "@tektum/grimoire-core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "default": "./dist/ports/*.js"
    },
    "./testing/*": {
      "types": "./dist/testing/*.d.ts",
      "default": "./dist/testing/*.js"
    },
    "./authorize": {
      "types": "./dist/authorize/index.d.ts",
      "default": "./dist/authorize/index.js"
    },
    "./authorize/*": {
      "types": "./dist/authorize/*.d.ts",
      "default": "./dist/authorize/*.js"
    },
    "./users/*": {
      "types": "./dist/users/*.d.ts",
      "default": "./dist/users/*.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "default": "./dist/pages/*.js"
    },
    "./attachments/*": {
      "types": "./dist/attachments/*.d.ts",
      "default": "./dist/attachments/*.js"
    },
    "./search/*": {
      "types": "./dist/search/*.d.ts",
      "default": "./dist/search/*.js"
    },
    "./jobs/*": {
      "types": "./dist/jobs/*.d.ts",
      "default": "./dist/jobs/*.js"
    },
    "./tree/*": {
      "types": "./dist/tree/*.d.ts",
      "default": "./dist/tree/*.js"
    }
  }
}
