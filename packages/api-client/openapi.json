              null
            ],
            "nullable": true,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "nullable": true,
            "type": "string"
          },
          "icon": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "position": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
