{
  "components": {
    "parameters": {},
    "schemas": {
      "ClientConfig": {
        "properties": {
          "collabUrl": {
            "description": "Address browsers use for live editing",
            "type": "string"
          },
          "fileStoreOrigin": {
            "description": "Public origin of the file store; null when no store is configured",
            "nullable": true,
            "type": "string"
          },
          "local": {
            "description": "True only in local (development) mode",
            "type": "boolean"
          },
          "minClientVersion": {
            "description": "Oldest client version the server accepts",
            "type": "string"
          },
          "providerProjectId": {
            "description": "Sign-in provider project id; null when none is configured",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "collabUrl",
          "minClientVersion",
          "local",
          "providerProjectId",
          "fileStoreOrigin"
        ],
        "type": "object"
      },
      "Collection": {
        "properties": {
          "color": {
            "nullable": true,
            "type": "string"
          },
          "defaultPermission": {
            "description": "What every member gets without an entry; null for nothing",
            "enum": [
              "read",
              "read_write",
              null
            ],
            "nullable": true,
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "icon": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "myPermission": {
            "description": "What the caller may do here",
            "enum": [
              "read-write",
              "read-only"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "description": "Sort key among collections; compare as bytes",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "color",
          "position",
          "defaultPermission",
          "myPermission"
        ],
        "type": "object"
      },
      "CollectionAccess": {
        "properties": {
          "defaultPermission": {
            "enum": [
              "read",
              "read_write",
              null
            ],
            "nullable": true,
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/CollectionAccessEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "defaultPermission",
          "entries"
        ],
        "type": "object"
      },
      "CollectionAccessEntry": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "Name of the user or the group",
            "type": "string"
          },
          "permission": {
            "enum": [
              "read",
              "read_write"
            ],
            "type": "string"
          },
          "principalId": {
            "format": "uuid",
            "type": "string"
          },
          "principalType": {
            "enum": [
              "user",
              "group"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "principalType",
          "principalId",
          "name",
          "permission"
        ],
        "type": "object"
      },
      "CollectionTreePage": {
        "properties": {
          "icon": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "parentId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "urlId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "urlId",
          "parentId",
          "position",
          "title",
          "icon"
        ],
        "type": "object"
      },
      "CreateCollection": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "maxLength": 64,
            "type": "string"
          },
          "defaultPermission": {
            "enum": [
              "read",
              "read_write"
            ],
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "icon": {
            "maxLength": 64,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GrantCollectionAccess": {
        "additionalProperties": false,
        "properties": {
          "permission": {
            "enum": [
              "read",
              "read_write"
            ],
            "type": "string"
          },
          "principalId": {
            "format": "uuid",
            "type": "string"
          },
          "principalType": {
            "enum": [
              "user",
              "group"
            ],
            "type": "string"
          }
        },
        "required": [
          "principalType",
          "principalId",
          "permission"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "email": {
            "description": "The sign-in email address",
            "type": "string"
          },
          "id": {
            "description": "The user id",
            "type": "string"
          },
          "name": {
            "description": "The display name",
            "type": "string"
          },
          "role": {
            "description": "The role of the user",
            "enum": [
              "admin",
              "member",
              "viewer"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "type": "object"
      },
      "PatchCollection": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "maxLength": 64,
            "nullable": true,
            "type": "string"
          },
          "defaultPermission": {
            "enum": [
              "read",
