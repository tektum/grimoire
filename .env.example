# Local development only. Every value below is a dummy; never reuse in production.
# `make up` copies this file to .env (ignored by git), which Compose reads: the keys below are the one place the
# development file-store keys and database password are written down for Compose (the db/init SQL repeats the password).
COMPOSE_PROJECT_NAME=grimoire
GRIMOIRE_DEV_DB_PASSWORD=grimoire-dev
GRIMOIRE_DEV_S3_ACCESS_KEY=grimoire-dev
GRIMOIRE_DEV_S3_SECRET_KEY=grimoire-dev-secret
# Runtime identity of the app: Read, Write and List on the grimoire bucket only (rendered into the file store identities by compose.yaml).
GRIMOIRE_DEV_S3_APP_ACCESS_KEY=grimoire-app
GRIMOIRE_DEV_S3_APP_SECRET_KEY=grimoire-app-dev-secret
GRIMOIRE_DATABASE_URL=postgresql://grimoire_app:grimoire-dev@127.0.0.1:55432/grimoire
GRIMOIRE_DATABASE_MIGRATION_URL=postgresql://grimoire_migrator:grimoire-dev@127.0.0.1:55432/grimoire
GRIMOIRE_S3_ENDPOINT=http://127.0.0.1:8333
GRIMOIRE_S3_BUCKET=grimoire
GRIMOIRE_S3_ACCESS_KEY=grimoire-app
GRIMOIRE_S3_SECRET_KEY=grimoire-app-dev-secret
# GRIMOIRE_DEV_TOKEN_SECRET is not written here on purpose: `make up` generates a random one into .env on first use (a fixed value would be a shared password).
# Empty is safe for local development; a non-local server requires a comma-separated list of lowercase domains.
GRIMOIRE_ALLOWED_EMAIL_DOMAINS=
# Empty selects the default Descope API endpoint; use an HTTP(S) URL only for a custom or local key server.
# Maximum accepted issued-token lifetime: 24 hours; the loader accepts 1 to 86400 seconds.
GRIMOIRE_DESCOPE_MAX_TOKEN_LIFETIME_SECONDS=86400
GRIMOIRE_DESCOPE_BASE_URL=
# Always empty in this example: this is a secret, and no real or realistic key belongs in the repository.
GRIMOIRE_DESCOPE_MANAGEMENT_KEY=
# Re-check collaboration access every 60 seconds; the loader accepts an integer from 1 to 600.
GRIMOIRE_COLLAB_RECHECK_SECONDS=60
# Unauthenticated sockets are closed and released after 5 seconds; the loader accepts 1 to 60 seconds.
GRIMOIRE_COLLAB_PREAUTH_TIMEOUT_SECONDS=5
# Authenticated resources per user: 20 sockets, 50 document sessions, and 2 MiB of updates per second across pages.
GRIMOIRE_COLLAB_MAX_SOCKETS_PER_USER=20
GRIMOIRE_COLLAB_MAX_DOCUMENTS_PER_USER=50
GRIMOIRE_COLLAB_BYTES_PER_SECOND_PER_USER=2097152
