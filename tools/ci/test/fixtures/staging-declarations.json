{
  "calls": [
    {
      "type": "descope:Project",
      "name": "Project",
      "args": {
        "name": "Grimoire staging",
        "tags": [
          "grimoire",
          "staging"
        ],
        "deletionProtection": true
      }
    },
    {
      "type": "descope:ProjectSettings",
      "name": "Settings",
      "args": {
        "projectId": "<Project.id>",
        "appUrl": "https://grimoire.descope.io",
        "approvedDomains": [
          "grimoire.descope.io"
        ]
      }
    },
    {
      "type": "descope:OtpSettings",
      "name": "Otp",
      "args": {
        "projectId": "<Project.id>",
        "disabled": false,
        "expirationTime": "5 minutes"
      }
    },
    {
      "type": "descope:JwtTemplate",
      "name": "UserToken",
      "args": {
        "projectId": "<Project.id>",
        "name": "grimoire-user",
        "description": "The tenant and the profile of the person, read by the server",
        "type": "user",
        "autoTenantClaim": true,
        "template": "{\"email\":\"{{user.email}}\",\"name\":\"{{user.name}}\",\"emailVerified\":\"{{user.verifiedEmail}}\"}"
      }
    },
    {
      "type": "descope:SessionSettings",
      "name": "Session",
      "args": {
        "projectId": "<Project.id>",
        "sessionTokenExpiration": "10 minutes",
        "refreshTokenExpiration": "3 weeks",
        "refreshTokenRotation": true,
        "userJwtTemplate": "<UserToken.id>"
      }
    },
    {
      "type": "descope:PasswordSettings",
      "name": "Password",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:MagiclinkSettings",
      "name": "Magiclink",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:EnchantedlinkSettings",
      "name": "Enchantedlink",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:EmbeddedlinkSettings",
      "name": "Embeddedlink",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:TotpSettings",
      "name": "Totp",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:PasskeySettings",
      "name": "Passkey",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:OauthSettings",
      "name": "Oauth",
      "args": {
        "projectId": "<Project.id>",
        "disabled": true
      }
    },
    {
      "type": "descope:Styles",
      "name": "Styles",
      "args": {
        "projectId": "<Project.id>",
        "data": "<document>"
      }
    },
    {
      "type": "descope:Flow",
      "name": "Flow-sign-up-or-in",
      "args": {
        "projectId": "<Project.id>",
        "flowId": "sign-up-or-in",
        "data": "<document>"
      },
      "opts": {
        "dependsOn": [
          "<Styles>",
          "<Settings>"
        ]
      }
    },
    {
      "type": "sst.aws:Vpc",
      "name": "Vpc",
      "args": {
        "nat": "ec2",
        "transform": {
          "natSecurityGroup": {
            "ingress": [
              {
                "protocol": "-1",
                "fromPort": 0,
                "toPort": 0,
                "cidrBlocks": [
                  "10.0.0.0/16"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "type": "aws.ec2:SecurityGroup",
      "name": "ServiceSecurityGroup",
      "args": {
        "vpcId": "<Vpc.id>",
        "description": "The service of one stage: its port is open to its load balancer alone"
      }
    },
    {
      "type": "aws.ec2:SecurityGroup",
      "name": "DbSecurityGroup",
      "args": {
        "vpcId": "<Vpc.id>",
        "description": "The database of one stage: PostgreSQL from the service of the same stage alone"
      }
    },
    {
      "type": "aws.vpc:SecurityGroupIngressRule",
      "name": "DbFromService",
      "args": {
        "securityGroupId": "<DbSecurityGroup.id>",
        "referencedSecurityGroupId": "<ServiceSecurityGroup.id>",
        "ipProtocol": "tcp",
        "fromPort": 5432,
        "toPort": 5432,
        "description": "PostgreSQL from the service"
      }
    },
    {
      "type": "aws.vpc:SecurityGroupEgressRule",
      "name": "ServiceToDatabase",
      "args": {
        "securityGroupId": "<ServiceSecurityGroup.id>",
        "referencedSecurityGroupId": "<DbSecurityGroup.id>",
        "ipProtocol": "tcp",
        "fromPort": 5432,
        "toPort": 5432,
        "description": "PostgreSQL to the database"
      }
    },
    {
      "type": "aws.vpc:SecurityGroupEgressRule",
      "name": "ServiceToHttps",
      "args": {
        "securityGroupId": "<ServiceSecurityGroup.id>",
        "cidrIpv4": "0.0.0.0/0",
        "ipProtocol": "tcp",
        "fromPort": 443,
        "toPort": 443,
        "description": "HTTPS to the identity provider, the file store and the registry"
      }
    },
    {
      "type": "aws.vpc:SecurityGroupEgressRule",
      "name": "ServiceToDnsUdp",
      "args": {
        "securityGroupId": "<ServiceSecurityGroup.id>",
        "cidrIpv4": "10.0.0.0/16",
        "ipProtocol": "udp",
        "fromPort": 53,
        "toPort": 53,
        "description": "Name resolution in the VPC"
      }
    },
    {
      "type": "aws.vpc:SecurityGroupEgressRule",
      "name": "ServiceToDnsTcp",
      "args": {
        "securityGroupId": "<ServiceSecurityGroup.id>",
        "cidrIpv4": "10.0.0.0/16",
        "ipProtocol": "tcp",
        "fromPort": 53,
        "toPort": 53,
        "description": "Name resolution in the VPC"
      }
    },
    {
      "type": "aws.kms:Key",
      "name": "VpcFlowLogsKey",
      "args": {
        "description": "Encrypts the VPC flow log group",
        "enableKeyRotation": true,
        "deletionWindowInDays": 30,
        "policy": "<aws.iam.getPolicyDocumentOutput({\"statements\":[{\"sid\":\"AccountAdministersTheKey\",\"effect\":\"Allow\",\"principals\":[{\"type\":\"AWS\",\"identifiers\":[\"<interpolate:arn:aws:iam::{<aws.getCallerIdentityOutput({}).accountId>}:root>\"]}],\"actions\":[\"kms:*\"],\"resources\":[\"*\"]},{\"sid\":\"CloudWatchLogsUsesTheKeyForThisGroupOnly\",\"effect\":\"Allow\",\"principals\":[{\"type\":\"Service\",\"identifiers\":[\"<interpolate:logs.{<aws.getRegionOutput.region>}.amazonaws.com>\"]}],\"actions\":[\"kms:Encrypt*\",\"kms:Decrypt*\",\"kms:ReEncrypt*\",\"kms:GenerateDataKey*\",\"kms:Describe*\"],\"resources\":[\"*\"],\"conditions\":[{\"test\":\"ArnEquals\",\"variable\":\"kms:EncryptionContext:aws:logs:arn\",\"values\":[\"<interpolate:arn:aws:logs:{<aws.getRegionOutput.region>}:{<aws.getCallerIdentityOutput({}).accountId>}:log-group:{/aws/vpc/grimoire-recorded/flow-logs}>\"]}]}]}).json>"
      }
    },
    {
      "type": "aws.cloudwatch:LogGroup",
      "name": "VpcFlowLogs",
      "args": {
        "name": "/aws/vpc/grimoire-recorded/flow-logs",
        "retentionInDays": 365,
        "kmsKeyId": "<VpcFlowLogsKey.arn>"
      }
    },
    {
      "type": "aws.iam:Role",
      "name": "VpcFlowLogsRole",
      "args": {
        "description": "Lets the VPC flow log service write the flow log group",
        "assumeRolePolicy": "<aws.iam.getPolicyDocumentOutput({\"statements\":[{\"effect\":\"Allow\",\"principals\":[{\"type\":\"Service\",\"identifiers\":[\"vpc-flow-logs.amazonaws.com\"]}],\"actions\":[\"sts:AssumeRole\"],\"conditions\":[{\"test\":\"StringEquals\",\"variable\":\"aws:SourceAccount\",\"values\":[\"<aws.getCallerIdentityOutput({}).accountId>\"]},{\"test\":\"ArnLike\",\"variable\":\"aws:SourceArn\",\"values\":[\"<interpolate:arn:aws:ec2:{<aws.getRegionOutput.region>}:{<aws.getCallerIdentityOutput({}).accountId>}:vpc-flow-log/*>\"]}]}]}).json>"
      }
    },
    {
      "type": "aws.iam:RolePolicy",
      "name": "VpcFlowLogsRolePolicy",
      "args": {
        "role": "<VpcFlowLogsRole.name>",
        "policy": "<aws.iam.getPolicyDocumentOutput({\"statements\":[{\"effect\":\"Allow\",\"actions\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\",\"logs:DescribeLogStreams\"],\"resources\":[\"<VpcFlowLogs.arn>\",\"<interpolate:{<VpcFlowLogs.arn>}:*>\"]}]}).json>"
      }
    },
    {
      "type": "aws.ec2:FlowLog",
      "name": "VpcFlowLog",
      "args": {
        "vpcId": "<Vpc.id>",
        "trafficType": "ALL",
        "logDestinationType": "cloud-watch-logs",
        "logDestination": "<VpcFlowLogs.arn>",
        "iamRoleArn": "<VpcFlowLogsRole.arn>",
        "maxAggregationInterval": 60
      },
      "opts": {
        "dependsOn": [
          "<VpcFlowLogsRolePolicy>"
        ]
      }
    },
    {
      "type": "sst.aws:Postgres",
      "name": "Db",
      "args": {
        "vpc": "<Vpc>",
        "version": "17.9",
        "transform": {
          "instance": {
            "vpcSecurityGroupIds": [
              "<DbSecurityGroup.id>"
            ]
          }
        }
      }
    },
    {
      "type": "random:RandomPassword",
      "name": "DbAppPassword",
      "args": {
        "length": 40,
        "special": false
      }
    },
    {
      "type": "random:RandomPassword",
      "name": "DbMigratorPassword",
      "args": {
        "length": 40,
        "special": false
      }
    },
    {
      "type": "random:RandomPassword",
      "name": "DbOpsPassword",
      "args": {
        "length": 40,
        "special": false
      }
    },
    {
      "type": "sst.aws:Bucket",
      "name": "Files",
      "args": {
        "cors": {
          "allowOrigins": [
            "https://grimoire.descope.io"
          ],
          "allowMethods": [
            "GET",
            "PUT",
            "HEAD"
          ],
          "allowHeaders": [
            "content-type",
            "content-disposition",
            "if-none-match",
            "x-amz-*"
          ],
          "exposeHeaders": [
            "ETag"
          ],
          "maxAge": "10 minutes"
        }
      }
    },
    {
      "type": "sst.aws:Cluster",
      "name": "Cluster",
      "args": {
        "vpc": "<Vpc>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "AdminUrl",
      "args": {
        "type": "SecureString",
        "value": "<resolve(user,secret,host,port,name)|apply(fn)>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "AppPassword",
      "args": {
        "type": "SecureString",
        "value": "<DbAppPassword.result>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "MigratorPassword",
      "args": {
        "type": "SecureString",
        "value": "<DbMigratorPassword.result>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "OpsPassword",
      "args": {
        "type": "SecureString",
        "value": "<DbOpsPassword.result>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "MigratorUrl",
      "args": {
        "type": "SecureString",
        "value": "<resolve(user,secret,host,port,name)|apply(fn)>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "AppUrl",
      "args": {
        "type": "SecureString",
        "value": "<resolve(user,secret,host,port,name)|apply(fn)>"
      }
    },
    {
      "type": "aws.ssm:Parameter",
      "name": "OpsUrl",
      "args": {
        "type": "SecureString",
        "value": "<resolve(user,secret,host,port,name)|apply(fn)>"
      }
    },
    {
      "type": "sst.aws:Service",
      "name": "Server",
      "args": {
        "cluster": "<Cluster>",
        "cpu": "0.5 vCPU",
        "memory": "2 GB",
        "scaling": {
          "min": 1,
          "max": 1
        },
        "containers": [
          {
            "name": "db-setup",
            "image": {
              "context": ".",
              "dockerfile": "Dockerfile"
            },
            "command": [
              "apps/server/dist/cli.js",
              "db-setup"
            ],
            "environment": {
              "NODE_EXTRA_CA_CERTS": "/app/certs/global-bundle.pem"
            },
            "ssm": {
              "GRIMOIRE_DATABASE_ADMIN_URL": "<AdminUrl.arn>",
              "GRIMOIRE_DB_APP_PASSWORD": "<AppPassword.arn>",
              "GRIMOIRE_DB_MIGRATOR_PASSWORD": "<MigratorPassword.arn>",
              "GRIMOIRE_DB_OPS_PASSWORD": "<OpsPassword.arn>"
            }
          },
          {
            "name": "migrate",
            "image": {
              "context": ".",
              "dockerfile": "Dockerfile"
            },
            "command": [
              "apps/server/dist/cli.js",
              "migrate"
            ],
            "environment": {
              "NODE_EXTRA_CA_CERTS": "/app/certs/global-bundle.pem"
            },
            "ssm": {
              "GRIMOIRE_DATABASE_MIGRATION_URL": "<MigratorUrl.arn>"
            }
          },
          {
            "name": "app",
            "image": {
              "context": ".",
              "dockerfile": "Dockerfile"
            },
            "environment": {
              "NODE_EXTRA_CA_CERTS": "/app/certs/global-bundle.pem",
              "GRIMOIRE_HOST": "0.0.0.0",
              "GRIMOIRE_PORT": "8080",
              "GRIMOIRE_ALLOWED_ORIGINS": "https://grimoire.descope.io",
              "GRIMOIRE_TRUSTED_PROXY": "10.0.0.0/16",
              "GRIMOIRE_DESCOPE_PROJECT_ID": "<Project.id>",
              "GRIMOIRE_ALLOWED_EMAIL_DOMAINS": "descope.com",
              "GRIMOIRE_FIRST_ADMIN_EMAILS": "omer@descope.com",
              "GRIMOIRE_PUBLIC_API_URL": "https://grimoire.descope.io",
              "GRIMOIRE_PUBLIC_COLLAB_URL": "wss://grimoire.descope.io/collab",
              "GRIMOIRE_WEB_ROOT": "/app/web",
              "GRIMOIRE_S3_ENDPOINT": "<interpolate:https://s3.{<aws.getRegionOutput.region>}.amazonaws.com>",
              "GRIMOIRE_S3_REGION": "<aws.getRegionOutput.region>",
              "GRIMOIRE_S3_BUCKET": "<Files.name>",
              "GRIMOIRE_S3_ADDRESSING_STYLE": "virtual",
              "GRIMOIRE_S3_CORS_MODE": "external",
              "GRIMOIRE_SEMANTIC_SEARCH": "off"
            },
            "ssm": {
              "GRIMOIRE_DATABASE_URL": "<AppUrl.arn>",
              "GRIMOIRE_DATABASE_OPS_URL": "<OpsUrl.arn>"
            }
          }
        ],
        "permissions": [
          {
            "actions": [
              "s3:GetObject",
              "s3:PutObject",
              "s3:DeleteObject"
            ],
            "resources": [
              "<interpolate:{<Files.arn>}/*>"
            ]
          },
          {
            "actions": [
              "s3:ListBucket"
            ],
            "resources": [
              "<Files.arn>"
            ]
          }
        ],
        "loadBalancer": {
          "domain": {
            "name": "grimoire.descope.io",
            "dns": {
              "call": "sst.aws.dns",
              "args": {
                "zone": "Z09474701DSI18DNI458V"
              }
            }
          },
          "rules": [
            {
              "listen": "80/http",
              "redirect": "443/https",
              "container": "app"
            },
            {
              "listen": "443/https",
              "forward": "8080/http",
              "container": "app"
            }
          ],
          "health": {
            "8080/http": {
              "path": "/readyz",
              "interval": "15 seconds",
              "timeout": "5 seconds",
              "healthyThreshold": 2,
              "unhealthyThreshold": 3,
              "successCodes": "200"
            }
          }
        },
        "transform": {
          "service": "<function>",
          "taskDefinition": "<function>"
        }
      }
    },
    {
      "type": "aws.vpc:SecurityGroupIngressRule",
      "name": "ServiceFromLoadBalancer",
      "args": {
        "securityGroupId": "<ServiceSecurityGroup.id>",
        "referencedSecurityGroupId": "<Server.nodes.loadBalancer.securityGroups|apply(fn)>",
        "ipProtocol": "tcp",
        "fromPort": 8080,
        "toPort": 8080,
        "description": "The service port from the load balancer"
      }
    },
    {
      "type": "aws.ec2:DefaultSecurityGroup",
      "name": "VpcDefaultSecurityGroup",
      "args": {
        "vpcId": "<Vpc.id>",
        "ingress": [],
        "egress": []
      },
      "opts": {
        "dependsOn": [
          "<Db>",
          "<Server>"
        ]
      }
    }
  ],
  "returned": {
    "url": "<Server.url>",
    "projectId": "<Project.id>"
  }
}
